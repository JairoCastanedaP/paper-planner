rules_version = '2';

// Reglas de seguridad de Firestore para Paper Planner.
// Se publican en: consola de Firebase → Firestore Database → Reglas.
//
// Cada cuenta solo puede leer y escribir lo que está bajo users/{su uid}.
// Todo lo demás queda cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
